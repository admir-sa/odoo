<odoo>
    <record id="view_shopify_order_buffer_tree" model="ir.ui.view">
        <field name="name">shopify.order.buffer.tree</field>
        <field name="model">shopify.order.buffer</field>
        <field name="arch" type="xml">
            <list>
                <field name="instance_id"/>
                <field name="shopify_order_id"/>
                <field name="order_name"/>
                <field name="sync_state"/>
                <field name="received_at"/>
                <field name="processed_at"/>
            </list>
        </field>
    </record>

    <record id="action_shopify_order_buffer" model="ir.actions.act_window">
        <field name="name">Order Buffers</field>
        <field name="res_model">shopify.order.buffer</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_shopify_order_buffer" name="Order Buffers" parent="menu_shopify_root" action="action_shopify_order_buffer"/>
</odoo>
